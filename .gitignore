# 環境変数（APIキー・秘密鍵を含むため必ずGit管理外にする）
.env

# Python仮想環境
venv/
.venv/

# Pythonキャッシュ
__pycache__/
*.py[cod]
*.pyo

# SQLiteデータベース（開発用データが含まれるため）
database.db

# アップロードファイル（一時ファイル）
uploads/*
!uploads/.gitkeep

# 出力ファイル（生成帳票）
outputs/*
!outputs/.gitkeep

# IDEの設定ファイル
.vscode/
.idea/

# OS生成ファイル
.DS_Store
Thumbs.db
